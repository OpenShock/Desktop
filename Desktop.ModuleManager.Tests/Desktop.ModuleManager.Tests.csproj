<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <RootNamespace>OpenShock.Desktop.ModuleManager.Tests</RootNamespace>
        <AssemblyName>OpenShock.Desktop.ModuleManager.Tests</AssemblyName>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Compile the loader source directly into the test assembly. The loader has no
            internal coupling beyond BCL types, so linking the source keeps the tests free of
            Desktop.Core's dependencies (SDKs, SignalR, hosting).
        -->
        <Compile Include="..\Desktop.Core\ModuleManager\ModuleAssemblyLoadContext.cs"
                 Link="Loader\ModuleAssemblyLoadContext.cs" />

        <!-- Same deal for the deep link parser, it only depends on BCL types. -->
        <Compile Include="..\Desktop.Core\Cli\Uri\UriParser.cs" Link="Cli\UriParser.cs" />
        <Compile Include="..\Desktop.Core\Cli\Uri\UriParameter.cs" Link="Cli\UriParameter.cs" />
        <Compile Include="..\Desktop.Core\Cli\Uri\UriParameterType.cs" Link="Cli\UriParameterType.cs" />

        <!-- Module page classification. Needs IComponent, hence the ASP.NET Core framework below. -->
        <Compile Include="..\Desktop.Core\ModuleManager\ModulePageTypes.cs" Link="ModuleManager\ModulePageTypes.cs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="System.IO.Ports" GeneratePathProperty="true" />
    </ItemGroup>

    <!--
        Stamp the resolved System.IO.Ports nuget package root into a file the integration
        test can read. We don't want to hardcode the package version or guess the global
        nuget cache path.
    -->
    <Target Name="WriteSystemIoPortsPackagePath" AfterTargets="ResolvePackageAssets" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_SystemIoPortsPackageRoot>$(PkgSystem_IO_Ports)</_SystemIoPortsPackageRoot>
        </PropertyGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)system_io_ports_package_path.txt"
                          Lines="$(_SystemIoPortsPackageRoot)"
                          Overwrite="true" />
        <ItemGroup>
            <Content Include="$(IntermediateOutputPath)system_io_ports_package_path.txt">
                <Link>system_io_ports_package_path.txt</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>

</Project>
