@inject ISnackbar Snackbar
@using OpenShock.Desktop.Logging
@using OpenShock.Desktop.Services
@using OpenShock.Desktop.Ui.ErrorHandling
@inherits LayoutComponentBase

<style>
    .childs-width-100 > * {
        width: 100%;
    }
    
</style>

<MudLayout>
    @* The sidebar is native (Avalonia) and sits next to this webview, so the layout is just the page. *@
    <div class="d-flex" style="width: 100vw; height: 100vh">

        @* Keeps a failing page - a module page above all - from replacing the whole page. *@
        <ContainerWithExceptionHandling Style="width: 100%; height: 100%; overflow-y: auto; overflow-x: hidden"
                                        Class="pa-6" MaximumErrorCount="25">
            @Body
        </ContainerWithExceptionHandling>
    </div>
</MudLayout>

@code {
    
    
    private void MsgNoty(string msg, Severity severity)
    {
        Snackbar.Add(msg, severity);
    }

    protected override void OnInitialized()
    {
        UiLogSink.ErrorNotification = message => MsgNoty(message, Severity.Error);
    }

}