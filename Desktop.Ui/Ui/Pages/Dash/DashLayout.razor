@using OpenShock.Desktop.Ui.ErrorHandling
@inherits LayoutComponentBase

@* The layout around module pages, the only pages left in the Blazor UI. Everything else, the sidebar included, is
   native and sits next to this webview, so the layout is just the page. *@

<MudLayout>
    <div class="d-flex" style="width: 100vw; height: 100vh">

        @* Keeps a failing module page from replacing the whole page. *@
        <ContainerWithExceptionHandling Style="width: 100%; height: 100%; overflow-y: auto; overflow-x: hidden"
                                        Class="pa-6" MaximumErrorCount="25">
            @Body
        </ContainerWithExceptionHandling>
    </div>
</MudLayout>
