@using OpenShock.Desktop.Ui.Pages.Dash
@using OpenShock.Desktop.Ui.Utils
@using OpenShock.Desktop.Ui.ErrorHandling
@using Microsoft.AspNetCore.Components.Routing
@inject ThemeDefinition ThemeDefinition
@inject WebUiBridge WebUiBridge
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@implements IDisposable

<MudThemeProvider Theme="ThemeDefinition.GetCurrentTheme()" IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<ContainerWithExceptionHandling>
    <Router AppAssembly="@typeof(Main).Assembly">
        <Found Context="routeData">
            <RouteView DefaultLayout="typeof(DashLayout)" RouteData="@routeData"/>
            <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(DashLayout)">
                <p role="alert">Sorry, there's nothing at this address. How did you get here?</p>
            </LayoutView>
        </NotFound>
    </Router>
</ContainerWithExceptionHandling>

@code {
    private IDisposable? _bridgeRegistration;

    protected override void OnInitialized()
    {
        // The sidebar is native now: it navigates us and follows where we go.
        NavigationManager.LocationChanged += OnLocationChanged;
        WebUiBridge.ReportLocation(CurrentPath());

        _bridgeRegistration = WebUiBridge.Attach(
            path => InvokeAsync(() => NavigationManager.NavigateTo(path)),
            (message, severity) => InvokeAsync(() => Snackbar.Add(message, ToSeverity(severity))));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => WebUiBridge.ReportLocation(CurrentPath());

    private string CurrentPath() =>
        "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimEnd('/');

    private static Severity ToSeverity(UiNotificationSeverity severity) => severity switch
    {
        UiNotificationSeverity.Success => Severity.Success,
        UiNotificationSeverity.Warning => Severity.Warning,
        UiNotificationSeverity.Error => Severity.Error,
        _ => Severity.Info
    };

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _bridgeRegistration?.Dispose();
    }
}
