<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Lets the module be built against an older Avalonia than the host, to test version skew. -->
    <SpikeModuleAvaloniaVersion Condition="'$(SpikeModuleAvaloniaVersion)' == ''">12.2.0</SpikeModuleAvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.2.0" Condition="'$(MSBuildProjectName)' == 'SpikeHost' Or '$(MSBuildProjectName)' == 'LegacyWebViewSpike'" />
    <PackageVersion Include="Avalonia" Version="$(SpikeModuleAvaloniaVersion)" Condition="'$(MSBuildProjectName)' != 'SpikeHost' And '$(MSBuildProjectName)' != 'LegacyWebViewSpike'" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Headless" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Skia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.15" />
    <PackageVersion Include="Humanizer.Core" Version="2.14.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
</Project>
