<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenShock.Spike.AvaloniaModule.Views"
             xmlns:c="using:OpenShock.Spike.AvaloniaModule.Controls"
             xmlns:h="using:OpenShock.Spike.Helpers"
             x:Class="OpenShock.Spike.AvaloniaModule.Views.ModulePage"
             x:DataType="vm:ModulePageViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://OpenShock.Spike.AvaloniaModule/Styles/ModuleStyles.axaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OpenShock.Spike.AvaloniaModule/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://OpenShock.Spike.AvaloniaModule/Controls/Badge.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <h:HumanizeConverter x:Key="Humanize" />
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Margin="24" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image x:Name="Logo" Source="avares://OpenShock.Spike.AvaloniaModule/Assets/logo.png" Width="64" Height="64" />
      <TextBlock x:Name="Title" Classes="accent" Text="Avalonia module page" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="Greeting" Text="{Binding Greeting}" />
    <Border x:Name="AccentBox" Background="{DynamicResource ModuleAccentBrush}" Height="8" />
    <TextBlock x:Name="Counter" Text="{Binding Clicks, Converter={StaticResource Humanize}}" />
    <Button x:Name="ClickButton" Content="Click me" Click="OnClick" />
    <c:Badge x:Name="Badge" Text="templated control" />
  </StackPanel>
</UserControl>
