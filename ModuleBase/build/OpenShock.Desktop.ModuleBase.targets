<Project>

  <!-- Host-provided assemblies that modules should NOT bundle -->
  <ItemGroup>
    <!-- ModuleBase itself -->
    <OpenShockHostAssembly Include="OpenShock.Desktop.ModuleBase" Version="1.1.2" />
    <OpenShockHostAssembly Include="OpenShock.MinimalEvents" Version="0.0.1" />

    <!-- UI framework -->
    <OpenShockHostAssembly Include="MudBlazor" Version="9.2.0" />

    <!-- OpenShock SDKs -->
    <OpenShockHostAssembly Include="OpenShock.SDK.CSharp" Version="0.0.40" />
    <OpenShockHostAssembly Include="OpenShock.SDK.CSharp.Hub" Version="0.0.40" />
    <OpenShockHostAssembly Include="OpenShock.SDK.CSharp.Live" Version="0.0.40" />

    <!-- Logging -->
    <OpenShockHostAssembly Include="Serilog" Version="4.3.1" />
    <OpenShockHostAssembly Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <OpenShockHostAssembly Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <OpenShockHostAssembly Include="Serilog.Sinks.Console" Version="6.1.1" />
    <OpenShockHostAssembly Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <OpenShockHostAssembly Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Microsoft.Extensions -->
    <OpenShockHostAssembly Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />

    <!-- ASP.NET Core / SignalR -->
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />

    <!-- Other host dependencies -->
    <OpenShockHostAssembly Include="System.Reactive" Version="6.1.0" />
    <OpenShockHostAssembly Include="Semver" Version="3.0.0" />
    <OpenShockHostAssembly Include="OneOf" Version="3.0.271" />
    <OpenShockHostAssembly Include="CommandLineParser" Version="2.9.1" />
    <OpenShockHostAssembly Include="dnlib" Version="4.5.0" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Components.Web" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.51" />
    <OpenShockHostAssembly Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <OpenShockHostAssembly Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.51" />
    <OpenShockHostAssembly Include="Photino.Blazor" Version="4.0.13" />
    <OpenShockHostAssembly Include="LucHeart.WebsocketLibrary" Version="1.1.0" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Authorization" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Components" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Connections.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Http.Connections.Client" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Http.Connections.Common" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.Metadata" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Diagnostics" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Features" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Localization" Version="10.0.1" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.1" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Logging.EventSource" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Primitives" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.Extensions.Validation" Version="10.0.5" />
    <OpenShockHostAssembly Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <OpenShockHostAssembly Include="Microsoft.JSInterop" Version="10.0.5" />
    <OpenShockHostAssembly Include="System.Diagnostics.EventLog" Version="10.0.5" />
  </ItemGroup>

  <!-- Modules can override specific host assemblies to force-bundle them.
       Use this when a module needs a different version of a host-provided package.
       Example: <OpenShockBundleOverride Include="Newtonsoft.Json" /> -->

  <!-- Modules can include extra directories from the publish output.
       Each item specifies a directory name relative to the publish dir.
       The directory and its contents will be placed under libs/{DirName}/ in the ZIP.
       Example: <OpenShockExtraDir Include="x64" /> -->

  <UsingTask TaskName="PackOpenShockModuleTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PublishDir Required="true" ParameterType="System.String" />
      <AssemblyName Required="true" ParameterType="System.String" />
      <ModuleId Required="true" ParameterType="System.String" />
      <OutputDir Required="true" ParameterType="System.String" />
      <HostAssemblies Required="true" ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <BundleOverrides Required="false" ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ExtraDirs Required="false" ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <DepsJsonPath Required="false" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
// Build exclusion set from the explicit host assembly list
var hostAssemblySet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
var hostVersions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
foreach (var item in HostAssemblies)
{
    var name = item.ItemSpec;
    hostAssemblySet.Add(name);
    var ver = item.GetMetadata("Version");
    if (!string.IsNullOrEmpty(ver))
        hostVersions[name] = ver;
}

// Remove bundle overrides from the exclusion set so they get included in the ZIP
var bundleOverrideSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
if (BundleOverrides != null)
{
    foreach (var item in BundleOverrides)
    {
        var name = item.ItemSpec;
        bundleOverrideSet.Add(name);
        hostAssemblySet.Remove(name);
        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
            "  Bundle override: {0} will be included despite being a host assembly", name);
    }
}

Func<string, bool> isExcluded = (name) => hostAssemblySet.Contains(name);

// Version mismatch detection from deps.json (using regex to avoid System.Text.Json dependency)
if (!string.IsNullOrEmpty(DepsJsonPath) && File.Exists(DepsJsonPath))
{
    try
    {
        var depsContent = File.ReadAllText(DepsJsonPath);
        // Match library entries like "PackageName/Version": { "type": ...
        var libRegex = new Regex(@"""([^""]+)/([^""]+)""\s*:\s*\{[^}]*""type""\s*:", RegexOptions.Compiled);
        foreach (Match match in libRegex.Matches(depsContent))
        {
            var pkgName = match.Groups[1].Value;
            var moduleVer = match.Groups[2].Value;
            if (hostVersions.TryGetValue(pkgName, out var hostVer))
            {
                var moduleMajor = moduleVer.Split('.')[0];
                var hostMajor = hostVer.Split('.')[0];
                if (moduleMajor != hostMajor)
                {
                    Log.LogWarning(
                        null, "OSMOD001", null, null, 0, 0, 0, 0,
                        "Module references {0} {1} but host provides {2}. Major version mismatch may cause runtime errors.",
                        pkgName, moduleVer, hostVer);
                }
            }
        }
    }
    catch (Exception ex)
    {
        Log.LogWarning("Failed to parse deps.json for version checking: " + ex.Message);
    }
}

// Collect files from publish directory
var publishDir = PublishDir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
var allDlls = Directory.GetFiles(publishDir, "*.dll", SearchOption.TopDirectoryOnly);
var allPdbs = Directory.GetFiles(publishDir, "*.pdb", SearchOption.TopDirectoryOnly);

var moduleAssembly = AssemblyName + ".dll";
var modulePdb = AssemblyName + ".pdb";

var included = new List<string>();
var excluded = new List<string>();
var libFiles = new List<string>();

foreach (var dll in allDlls)
{
    var fileName = Path.GetFileName(dll);
    var asmName = Path.GetFileNameWithoutExtension(dll);

    if (string.Equals(fileName, moduleAssembly, StringComparison.OrdinalIgnoreCase))
        continue; // handled separately

    if (isExcluded(asmName))
    {
        excluded.Add(asmName);
    }
    else
    {
        libFiles.Add(dll);
        included.Add(asmName);
    }
}

// Collect native libraries from runtimes/ subdirectories
var nativeFiles = new List<(string rid, string filePath)>();
var runtimesDir = Path.Combine(publishDir, "runtimes");
if (Directory.Exists(runtimesDir))
{
    foreach (var ridDir in Directory.GetDirectories(runtimesDir))
    {
        var rid = Path.GetFileName(ridDir);
        var nativeDir = Path.Combine(ridDir, "native");
        if (Directory.Exists(nativeDir))
        {
            foreach (var nativeFile in Directory.GetFiles(nativeDir))
            {
                nativeFiles.Add((rid, nativeFile));
            }
        }
        // Also check lib/ subdirectories for managed RID-specific assemblies
        var libDir = Path.Combine(ridDir, "lib");
        if (Directory.Exists(libDir))
        {
            foreach (var tfmDir in Directory.GetDirectories(libDir))
            {
                foreach (var managedFile in Directory.GetFiles(tfmDir, "*.dll"))
                {
                    var asmName = Path.GetFileNameWithoutExtension(managedFile);
                    if (!isExcluded(asmName))
                    {
                        nativeFiles.Add((rid, managedFile));
                    }
                }
            }
        }
    }
}

// Collect extra native directories specified by the module
if (ExtraDirs != null)
{
    foreach (var item in ExtraDirs)
    {
        var dirName = item.ItemSpec;
        var dirPath = Path.Combine(publishDir, dirName);
        if (Directory.Exists(dirPath))
        {
            foreach (var file in Directory.GetFiles(dirPath, "*", SearchOption.AllDirectories))
            {
                var relativePath = file.Substring(dirPath.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                nativeFiles.Add((Path.Combine(dirName, Path.GetDirectoryName(relativePath) ?? "").TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), file));
            }
        }
        else
        {
            Log.LogWarning("Extra directory '{0}' not found in publish output", dirPath);
        }
    }
}

// Create staging directory
var moduleIdLower = ModuleId.ToLowerInvariant();
var stagingBase = Path.Combine(publishDir, "_module_staging");
var stagingDir = Path.Combine(stagingBase, moduleIdLower);
var stagingLibs = Path.Combine(stagingDir, "libs");

if (Directory.Exists(stagingBase))
    Directory.Delete(stagingBase, true);

Directory.CreateDirectory(stagingLibs);

// Copy module assembly
var srcModule = Path.Combine(publishDir, moduleAssembly);
if (File.Exists(srcModule))
    File.Copy(srcModule, Path.Combine(stagingDir, moduleAssembly), true);

var srcModulePdb = Path.Combine(publishDir, modulePdb);
if (File.Exists(srcModulePdb))
    File.Copy(srcModulePdb, Path.Combine(stagingDir, modulePdb), true);

// Copy lib dependencies
foreach (var libDll in libFiles)
{
    var fileName = Path.GetFileName(libDll);
    File.Copy(libDll, Path.Combine(stagingLibs, fileName), true);

    // Copy matching PDB if it exists
    var pdbPath = Path.ChangeExtension(libDll, ".pdb");
    if (File.Exists(pdbPath))
        File.Copy(pdbPath, Path.Combine(stagingLibs, Path.GetFileNameWithoutExtension(libDll) + ".pdb"), true);
}

// Copy native/RID-specific files
foreach (var (rid, filePath) in nativeFiles)
{
    var ridDir = Path.Combine(stagingLibs, rid);
    Directory.CreateDirectory(ridDir);
    File.Copy(filePath, Path.Combine(ridDir, Path.GetFileName(filePath)), true);
}

// Create ZIP
var zipPath = Path.Combine(OutputDir, AssemblyName + ".module.zip");
if (File.Exists(zipPath))
    File.Delete(zipPath);

ZipFile.CreateFromDirectory(stagingDir, zipPath);

// Cleanup staging
Directory.Delete(stagingBase, true);

// Log summary
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
    "OpenShock Module packaged: {0}", zipPath);
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
    "  Module assembly: {0}", moduleAssembly);
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
    "  Included dependencies ({0}): {1}", included.Count, string.Join(", ", included));
if (nativeFiles.Count > 0)
    Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
        "  Native/RID-specific files ({0}): {1}", nativeFiles.Count,
        string.Join(", ", nativeFiles.Select(n => n.rid + "/" + Path.GetFileName(n.filePath))));
Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
    "  Excluded ({0}): {1}", excluded.Count, string.Join(", ", excluded));
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="PackOpenShockModule"
          AfterTargets="Publish"
          Condition="'$(OpenShockPackModule)' == 'true'">
    <PropertyGroup>
      <OpenShockModuleOutputDir Condition="'$(OpenShockModuleOutputDir)' == ''">$(PublishDir)</OpenShockModuleOutputDir>
    </PropertyGroup>
    <PackOpenShockModuleTask
      PublishDir="$(PublishDir)"
      AssemblyName="$(AssemblyName)"
      ModuleId="$(OpenShockModuleId)"
      OutputDir="$(OpenShockModuleOutputDir)"
      HostAssemblies="@(OpenShockHostAssembly)"
      BundleOverrides="@(OpenShockBundleOverride)"
      ExtraDirs="@(OpenShockExtraDir)"
      DepsJsonPath="$(PublishDir)$(AssemblyName).deps.json" />
  </Target>

</Project>
