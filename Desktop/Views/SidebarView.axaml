<!--
  The sidebar, a port of the Blazor SideBar: logo, navigation, installed modules, permission warning, connection
  status and the account bar. Everything popping out of it (tooltips, menus, the hubs popup) is a separate popup
  window, so it draws over the webview next to it.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenShock.Desktop.ViewModels"
             xmlns:v="using:OpenShock.Desktop.Views"
             xmlns:t="using:OpenShock.Desktop.Theming"
             xmlns:svg="using:Avalonia.Svg.Skia"
             x:Class="OpenShock.Desktop.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.DataTemplates>
        <!-- A link, or a module group with its links underneath. Children reuse this template. -->
        <DataTemplate DataType="vm:NavItemViewModel">
            <StackPanel>
                <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding ActivateCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="24" Height="24">
                            <t:IconView Data="{Binding IconGeometry}" IsVisible="{Binding !HasIconImage}" />
                            <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <t:IconView Grid.Column="2" Classes="chevron" Classes.expanded="{Binding IsExpanded}"
                                    Data="{x:Static t:MaterialIcons.ExpandMore}" IsVisible="{Binding IsGroup}" />
                    </Grid>
                </Button>
                <ItemsControl Classes="children" ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}" />
            </StackPanel>
        </DataTemplate>

        <!-- Hubs / Shared: one status row, details in a popup. -->
        <DataTemplate DataType="vm:HubsIndicatorViewModel">
            <Button Classes="status-row" IsVisible="{Binding HasHubs}" ToolTip.Tip="{Binding PopoverTitle}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="10" Height="10" Fill="{Binding AggregateBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="body2" Margin="10,0" Text="{Binding Label}" />
                    <TextBlock Grid.Column="2" Classes="caption muted" Text="{Binding CountText}"
                               VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <v:HubsPopupView />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="svg|Svg.logo-ring">
            <Style.Animations>
                <Animation Duration="0:0:10" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ItemsControl.children Button.nav">
            <Setter Property="Padding" Value="32,10,16,10" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Logo -->
        <StackPanel DockPanel.Dock="Top">
            <Button Classes="icon" CornerRadius="0" Padding="16,8" HorizontalAlignment="Left"
                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:SidebarViewModel.DashboardRoute}">
                <Panel Width="218" Height="45">
                    <svg:Svg Path="avares://OpenShock.Desktop/Assets/Images/NavbarLogo.svg" />
                    <!-- The ring turns slowly, as the SVG's animateTransform does in the browser. The origin is the
                         ring's centre within the logo. -->
                    <svg:Svg Classes="logo-ring" Path="avares://OpenShock.Desktop/Assets/Images/NavbarLogoRing.svg"
                             RenderTransformOrigin="5.998%,50%">
                        <svg:Svg.RenderTransform>
                            <RotateTransform />
                        </svg:Svg.RenderTransform>
                    </svg:Svg>
                </Panel>
            </Button>
            <Separator Classes="middle" Margin="16,0,16,5" />
        </StackPanel>

        <!-- Footer: permissions, status, account bar -->
        <StackPanel DockPanel.Dock="Bottom">

            <Border IsVisible="{Binding MissingPermissions}" Background="Transparent" Margin="0,0,0,8">
                <ToolTip.Tip>
                    <StackPanel MaxWidth="300" Spacing="4">
                        <TextBlock Classes="body2" Text="Your API token is missing permissions" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="One or more installed modules need permissions this token does not have. Log out and back in to get a token that has all of them." />
                        <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PermissionEntry">
                                    <TextBlock Classes="subtitle2" Text="{Binding Name}" Foreground="{Binding Brush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16">
                    <t:IconView Data="{x:Static t:MaterialIcons.Warning}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Classes="body2" Text="Permissions Required" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Separator Classes="middle" />

            <StackPanel Margin="16">
                <!-- Same row shape as the hub entries below, so the three line up exactly. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                    <Ellipse Width="10" Height="10" Fill="{Binding BackendBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="body2" Margin="10,0" Text="Backend" />
                    <TextBlock Grid.Column="2" Classes="caption muted" Text="{Binding BackendLabel}"
                               VerticalAlignment="Center" />
                </Grid>

                <ContentControl Content="{Binding OwnHubs}" />
                <ContentControl Content="{Binding SharedHubs}" />

                <!-- Account, settings, logs -->
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,10,0,0">

                    <Button Classes="icon" Padding="4" ToolTip.Tip="{Binding AccountTooltip}">
                        <Panel Width="40" Height="40">
                            <t:IconView Data="{x:Static t:MaterialIcons.AccountCircle}" Width="36" Height="36"
                                        IsVisible="{Binding IsNotAuthed}" />
                            <Border Background="{DynamicResource ErrorBrush}" CornerRadius="20"
                                    IsVisible="{Binding IsAuthFailed}">
                                <t:IconView Data="{x:Static t:MaterialIcons.PersonOff}" Foreground="White"
                                            Width="22" Height="22" />
                            </Border>
                            <Arc Classes="spinner" Width="30" Height="30" IsVisible="{Binding IsAuthenticating}">
                                <Arc.RenderTransform>
                                    <RotateTransform />
                                </Arc.RenderTransform>
                            </Arc>
                            <Ellipse Fill="{DynamicResource DarkBrush}" IsVisible="{Binding IsAuthed}" />
                            <Ellipse IsVisible="{Binding IsAuthed}">
                                <Ellipse.Fill>
                                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Panel>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuItem Header="{Binding AccountName}" IsEnabled="False" IsVisible="{Binding IsAuthed}" />
                                <Separator IsVisible="{Binding IsAuthed}" />

                                <MenuItem IsEnabled="False" IsVisible="{Binding ShowFailure}">
                                    <MenuItem.Header>
                                        <TextBlock Classes="body2" Text="{Binding FailureMessage}" MaxWidth="300"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="Try Again" Command="{Binding RetryLoginCommand}"
                                          IsVisible="{Binding ShowFailure}">
                                    <MenuItem.Icon>
                                        <t:IconView Data="{x:Static t:MaterialIcons.Autorenew}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator IsVisible="{Binding ShowFailure}" />

                                <MenuItem Header="{Binding CheckForUpdateText}" Command="{Binding CheckForUpdatesCommand}"
                                          IsEnabled="{Binding CanCheckForUpdate}">
                                    <MenuItem.Icon>
                                        <t:IconView Data="{x:Static t:MaterialIcons.Refresh}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Debug" Command="{Binding OpenDebugCommand}">
                                    <MenuItem.Icon>
                                        <t:IconView Data="{x:Static t:MaterialIcons.BugReport}" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />

                                <MenuItem Header="Logout" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthed}">
                                    <MenuItem.Icon>
                                        <t:IconView Data="{x:Static t:MaterialIcons.Logout}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Login" Command="{Binding LoginCommand}"
                                          IsVisible="{Binding IsNotAuthedOrFailed}">
                                    <MenuItem.Icon>
                                        <t:IconView Data="{x:Static t:MaterialIcons.Login}" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />
                                <MenuItem Header="{Binding VersionText}" IsEnabled="False" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="2" Classes="icon" Classes.active="{Binding IsSettingsActive}"
                            ToolTip.Tip="Settings" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:SidebarViewModel.SettingsRoute}">
                        <t:IconView Data="{x:Static t:MaterialIcons.Settings}" />
                    </Button>

                    <Button Grid.Column="4" Classes="icon" Classes.active="{Binding IsLogsActive}"
                            ToolTip.Tip="Logs" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:SidebarViewModel.LogsRoute}">
                        <t:IconView Data="{x:Static t:MaterialIcons.Article}" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Navigation -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding MainItems}" />

                <StackPanel IsVisible="{Binding HasModules}">
                    <Separator Classes="middle" Margin="16,5" />
                    <!-- Says what the links below it are, which a bare divider left to guesswork. -->
                    <TextBlock Classes="section-label" Text="Modules" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ModuleItems}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
