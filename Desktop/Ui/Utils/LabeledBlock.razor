@* Label, optional value on the same line, content across the full width beneath. The layout for
   anything a LabeledRow cannot fit next to its label: a slider, a wrapping list, a text area. *@

<div class="@Classname" style="@Style" @attributes="UserAttributes">
    <div class="d-flex align-baseline justify-space-between gap-4">
        @if (LabelContent is not null)
        {
            @LabelContent
        }
        else
        {
            <MudText Typo="@LabelTypo">@Label</MudText>
        }

        @if (ValueContent is not null)
        {
            @ValueContent
        }
        else if (!string.IsNullOrEmpty(Value))
        {
            <MudText Typo="Typo.body2" Color="Color.Primary">@Value</MudText>
        }
    </div>

    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Description</MudText>
    }

    <div class="@ContentClass">
        @ChildContent
    </div>
</div>

@code {

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Description { get; set; }

    /// <summary>Current value, shown right aligned on the label line.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Replaces the plain <see cref="Label"/> text.</summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }

    /// <summary>Replaces the plain <see cref="Value"/> text.</summary>
    [Parameter] public RenderFragment? ValueContent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public Typo LabelTypo { get; set; } = Typo.body2;

    /// <summary>Layout of the content beneath the label.</summary>
    [Parameter] public string ContentClass { get; set; } = "d-flex align-center gap-4 mt-2";

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private string Classname => $"py-3 {Class}".TrimEnd();

}
