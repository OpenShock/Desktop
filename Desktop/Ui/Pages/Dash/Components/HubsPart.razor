@using LucHeart.WebsocketLibrary
@using OpenShock.Desktop.Models
@using OpenShock.Desktop.ModuleBase.StableInterfaces
@using OpenShock.Desktop.Ui.Utils
@using OpenShock.SDK.CSharp.Live
@implements IAsyncDisposable

@* A set of hubs as one indicator in the sidebar, with the detail a click away. The rail is 250px
   wide, so a row per hub does not fit; the dashboard is where they are all written out. *@

<div style="position: relative;">
    <div class="sidebar-status-row clickable" role="button" tabindex="0" aria-label="@PopoverTitle"
         @onclick="@(() => _open = !_open)">
        <span class="dot" style="@($"background: var(--mud-palette-{AggregatePalette});")"></span>
        <MudText Typo="Typo.body2" Class="label">@Label</MudText>
        <MudText Typo="Typo.caption" Class="value">@OnlineHubs/@TotalHubs</MudText>
    </div>

    @* Must render before the popover so it sits behind it in the stack. *@
    <MudOverlay Visible="_open" OnClick="@(() => _open = false)" LockScroll="false"/>

    <MudPopover Open="_open" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter"
                Class="hubs-popover rounded-lg">
        @* Fixed width, not min/max: a content sized popover resizes on every latency tick. *@
        <div style="width: 272px; padding: 12px 14px 10px;">
            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
                <MudIcon Icon="@Icon" Size="Size.Small"/>
                <MudText Typo="Typo.subtitle2">@PopoverTitle</MudText>
                <div style="flex-grow: 1"></div>
                <MudText Typo="Typo.caption" Style="opacity: 0.6">@OnlineHubs/@TotalHubs online</MudText>
            </div>
            <MudDivider Style="margin-bottom: 8px;"/>

            @foreach (var group in Groups)
            {
                @if (group.Name is null)
                {
                    @foreach (var hub in group.Hubs)
                    {
                        @Row(hub, hub.Name, false)
                    }
                }
                else if (group.Hubs.Count == 1)
                {
                    // A single hub is redundant with the group, so collapse into one row.
                    @Row(group.Hubs[0], group.Name, false)
                }
                else
                {
                    <div style="display: flex; align-items: center; gap: 6px; padding: 6px 0 2px;">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="opacity: 0.7"/>
                        <MudText Typo="Typo.body2" Style="font-weight: 600">@group.Name.Truncate(20)</MudText>
                    </div>
                    @foreach (var hub in group.Hubs)
                    {
                        @Row(hub, hub.Name, true)
                    }
                }
            }
        </div>
    </MudPopover>
</div>

<style>
    .hubs-popover {
        border: solid 1px var(--mud-palette-lines-default);
        /* Clips the content to the rounded corners, which the border would otherwise cut across. */
        overflow: hidden;
    }
</style>

@code {
    private bool _open;

    /// <summary>The hubs to show, in the groups they should be listed under.</summary>
    [Parameter]
    public required IReadOnlyList<HubGroup> Groups { get; set; }

    /// <summary>Short label above the icon, for example "Hubs" or "Shared".</summary>
    [Parameter]
    public required string Label { get; set; }

    [Parameter]
    public required string Icon { get; set; }

    /// <summary>Heading inside the popover, for example "Your hubs".</summary>
    [Parameter]
    public required string PopoverTitle { get; set; }

    /// <summary>
    /// Resolves the active live control client for a hub, or null when no live control connection is open.
    /// </summary>
    [Parameter]
    public required Func<Guid, IOpenShockLiveControlClient?> GetClient { get; set; }

    private RenderFragment Row(IOpenShockHub hub, string name, bool indented) =>
        @<div style="@($"display: flex; align-items: center; gap: 8px; padding: {(indented ? "2px 0 2px 20px" : "3px 0")};")">
            <MudTooltip Text="@GatewayOf(hub)" Disabled="@(GatewayOf(hub) is null)"
                        Arrow="true" Placement="Placement.Top">
                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
                         Color="HubColor(hub)" Style="@DotStyle(hub)"/>
            </MudTooltip>
            <MudText Typo="@(indented ? Typo.caption : Typo.body2)">@name.Truncate(indented ? 22 : 20)</MudText>
            <div style="flex-grow: 1; min-width: 12px"></div>
            <MudText Typo="Typo.caption" Style="opacity: 0.6">@StateLabel(hub)</MudText>
            @if (LatencyText(hub) is { } latency)
            {
                <MudText Typo="Typo.caption" Style="@LatencySlotStyle">@latency</MudText>
            }
        </div>;

    private IEnumerable<IOpenShockHub> AllHubs => Groups.SelectMany(g => g.Hubs);

    private int OnlineHubs => AllHubs.Count(h => h.Status.Online);
    private int TotalHubs => AllHubs.Count();

    private string AggregatePalette
    {
        get
        {
            if (AllHubs.Any(h => GetClient(h.Id)?.State.Value == WebsocketConnectionState.Connected))
                return "success";

            return OnlineHubs > 0 ? "info" : "dark";
        }
    }

    private Color HubColor(IOpenShockHub hub)
    {
        var client = GetClient(hub.Id);
        if (client != null)
            return client.State.Value switch
            {
                WebsocketConnectionState.Connected => Color.Success,
                WebsocketConnectionState.Connecting => Color.Warning,
                WebsocketConnectionState.WaitingForReconnect => Color.Warning,
                _ => Color.Error
            };

        return hub.Status.Online ? Color.Info : Color.Dark;
    }

    /// <summary>
    /// Fixed width tabular slot, so a latency going from 9ms to 112ms does not shove the row sideways on every tick.
    /// </summary>
    private const string LatencySlotStyle =
        "opacity: 0.6; font-variant-numeric: tabular-nums; min-width: 46px; text-align: right;";

    private string StateLabel(IOpenShockHub hub)
    {
        var client = GetClient(hub.Id);
        if (client == null) return hub.Status.Online ? "idle" : "offline";

        return client.State.Value.ToString();
    }

    /// <summary>
    /// The hub's live control latency, or null when there is no socket up.
    /// </summary>
    private string? LatencyText(IOpenShockHub hub)
    {
        var client = GetClient(hub.Id);
        if (client == null || client.State.Value != WebsocketConnectionState.Connected) return null;

        return $"{client.Latency.Value}ms";
    }

    private string? GatewayOf(IOpenShockHub hub) => GetClient(hub.Id)?.Gateway;

    private string DotStyle(IOpenShockHub hub) => GatewayOf(hub) is null ? string.Empty : "cursor: help;";

    private readonly Dictionary<Guid, HubSubscription> _subscriptions = new();

    private readonly record struct HubSubscription(
        IOpenShockLiveControlClient Client,
        IAsyncDisposable State,
        IAsyncDisposable Latency);

    protected override async Task OnParametersSetAsync()
    {
        // Clients are created lazily and disposed once idle, so keep each hub's subscriptions pointed at whatever
        // client is current.
        var live = new HashSet<Guid>();

        foreach (var hub in AllHubs)
        {
            // Blazor does not wait for a pending OnParametersSetAsync before disposing, and the awaits below would
            // repopulate a dictionary DisposeAsync has already drained.
            if (_disposed) return;

            var client = GetClient(hub.Id);
            if (client == null) continue;

            live.Add(hub.Id);

            if (_subscriptions.TryGetValue(hub.Id, out var existing))
            {
                if (ReferenceEquals(existing.Client, client)) continue;
                await UnsubscribeAsync(hub.Id);
            }

            var stateSubscription = await client.State.Updated.SubscribeAsync(_ => InvokeAsync(StateHasChanged));
            var latencySubscription = await client.Latency.Updated.SubscribeAsync(_ => InvokeAsync(RenderIfOpen));

            // Disposal can also land while those two awaits are in flight.
            if (_disposed)
            {
                await stateSubscription.DisposeAsync();
                await latencySubscription.DisposeAsync();
                return;
            }

            _subscriptions[hub.Id] = new HubSubscription(client, stateSubscription, latencySubscription);
        }

        foreach (var hubId in _subscriptions.Keys.Where(id => !live.Contains(id)).ToArray())
            await UnsubscribeAsync(hubId);
    }

    /// <summary>
    /// Latency only shows inside the popover and ticks several times a second, so skip the render while it is closed.
    /// </summary>
    private void RenderIfOpen()
    {
        if (_open) StateHasChanged();
    }

    private async Task UnsubscribeAsync(Guid hubId)
    {
        if (!_subscriptions.Remove(hubId, out var subscription)) return;

        await subscription.State.DisposeAsync();
        await subscription.Latency.DisposeAsync();
    }

    private bool _disposed;

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        foreach (var hubId in _subscriptions.Keys.ToArray())
            await UnsubscribeAsync(hubId);
    }
}
