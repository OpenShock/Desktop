@using Microsoft.AspNetCore.SignalR.Client
@using OpenShock.Desktop.Backend
@using OpenShock.Desktop.ModuleBase.Models
@using OpenShock.Desktop.Models
@using OpenShock.Desktop.ModuleManager
@using OpenShock.Desktop.Services
@using OpenShock.Desktop.Ui.Utils
@using OpenShock.SDK.CSharp.Hub
@using OpenShock.Desktop.Ui.Pages.Dash.Components
@using OpenShock.Desktop.Ui.ErrorHandling
@using OpenShock.SDK.CSharp.Models
@inject OpenShockApi Api
@inject OpenShockHubClient ApiHubClient
@inject ISnackbar Snackbar
@inject LiveControlManager LiveControlManager
@inject StatusHandler StatusHandler
@inject ModuleManager ModuleManager
@inject AuthService AuthService
@implements IAsyncDisposable

<MudPaper Width="250px" Height="100%" Elevation="0" Class="flex-none">

    <div class="d-flex childs-width-100" style="height: 100%; flex-direction: column">

        <div class="flex-none">
            <div class="d-flex" style="align-items: center">
                @* ReSharper disable once Html.PathError *@
                <a href="/dash/dashboard">
                    <MudImage Src="images/NavbarLogoSpin.svg" Alt="Logo" Height="45" Width="218"
                              Class="mx-4 my-2"/>
                </a>
            </div>
            <MudDivider Style="margin-bottom: 5px" DividerType="DividerType.Middle"/>
        </div>


        <MudNavMenu Style="overflow-y: auto" Class="flex-auto flex-grow-1" Margin="Margin.Dense"
                    Color="Color.Primary" Bordered="true">

            <MudNavLink Icon="@Icons.Material.Filled.SpaceDashboard" Href="/dash/dashboard"
                        Match="NavLinkMatch.All">Dashboard</MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.ElectricBolt" Href="/dash/shockers">Shockers</MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.ViewModule" Href="/dash/modules">Modules</MudNavLink>

            @if (!ModuleManager.Modules.IsEmpty)
            {
                <MudDivider Style="margin-bottom: 5px; margin-top: 5px;" DividerType="DividerType.Middle"/>

                @* Says what the links below it are, which the bare divider left to guesswork. *@
                <MudText Typo="Typo.caption" Class="sidebar-section-label mud-text-secondary">Modules</MudText>
            }

            @foreach (var modules in ModuleManager.Modules)
            {
                @* The sidebar renders on every page, so an exception escaping a module's entry
                   would take the whole app with it. Contain it to the one entry. *@
                <ContainerWithExceptionHandling MaximumErrorCount="5">
                    <ChildContent>
                        <ModuleNavComponent LoadedModule="@modules.Value"></ModuleNavComponent>
                    </ChildContent>
                    <ErrorContent>
                        <MudTooltip Arrow="true" Placement="Placement.Right"
                                    Text="@("This module's navigation could not be rendered: " + context.Message)">
                            <div class="mud-nav-link" style="cursor: default">
                                <MudIcon Icon="@Icons.Material.Filled.ExtensionOff" Color="Color.Error"/>
                                <div class="mud-nav-link-text">@modules.Value.Name</div>
                            </div>
                        </MudTooltip>
                    </ErrorContent>
                </ContainerWithExceptionHandling>
            }
        </MudNavMenu>

        <div class="flex-none">
            @if (AuthService.MissingPermissions)
            {
                <MudTooltip
                    Arrow="true" Placement="Placement.Right">
                    <ChildContent>
                        <div class="mb-2 pa-4 flex row gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning"/>
                            <MudText Typo="Typo.body2" Class="mt-1">Permissions Required</MudText>
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Your API token is missing permissions</MudText>
                        <MudText Typo="Typo.caption">
                            One or more installed modules need permissions this token does not have.
                            Log out and back in to get a token that has all of them.
                        </MudText>

                        <div class="mt-3">
                            @foreach (var perm in PermissionInfos)
                            {
                                <MudText Typo="Typo.subtitle2"
                                         Color="@(perm.Missing ? Color.Warning : Color.Default)">@perm.Permission</MudText>
                            }
                        </div>
                    </TooltipContent>
                </MudTooltip>
            }

            <MudDivider DividerType="DividerType.Middle"/>
            <div Class="pa-4">
                <div class="d-flex flex-column" style="margin-bottom: 10px;">

                    @* Same row shape as the hub entries below, so the three line up exactly. *@
                    <div class="sidebar-status-row">
                        <span class="dot" style="@($"background: var(--mud-palette-{BackendPalette});")"></span>
                        <MudText Typo="Typo.body2" Class="label">Backend</MudText>
                        <MudText Typo="Typo.caption" Class="value">@BackendStateLabel</MudText>
                    </div>

                    @if (Api.Hubs.Value.Count > 0)
                    {
                        <HubsPart Label="Hubs" Icon="@Icons.Material.Filled.Router" PopoverTitle="Your hubs"
                                  Groups="OwnHubGroups" GetClient="LiveControlManager.GetClient"/>
                    }

                    @if (Api.SharedOwners.Value.Count > 0)
                    {
                        <HubsPart Label="Shared" Icon="@Icons.Material.Filled.Group" PopoverTitle="Shared hubs"
                                  Groups="SharedHubGroups" GetClient="LiveControlManager.GetClient"/>
                    }

                </div>
                <UpdateLogout/>
            </div>
        </div>

    </div>
</MudPaper>

@code {
    private IAsyncDisposable _statusSubscription = null!;
    private IAsyncDisposable _authStateSubscription = null!;
    private IAsyncDisposable _liveControlSubscription = null!;
    private IAsyncDisposable _sharedOwnersSubscription = null!;

    protected override async Task OnInitializedAsync()
    {
        _statusSubscription = await StatusHandler.OnWebsocketStatusChanged.SubscribeAsync(() => InvokeAsync(StateHasChanged));
        _authStateSubscription = await AuthService.AuthState.ValueUpdated.SubscribeAsync(_ => InvokeAsync(StateHasChanged));

        // Connections open lazily and are pruned when idle, so GetClient flips with nothing else changing.
        _liveControlSubscription = await LiveControlManager.OnStateUpdated.SubscribeAsync(() => InvokeAsync(StateHasChanged));
        _sharedOwnersSubscription = await Api.SharedOwners.ValueUpdated.SubscribeAsync(_ => InvokeAsync(StateHasChanged));
    }

    /// <summary>The user's own hubs need no attribution, so they go in one unnamed group.</summary>
    private IReadOnlyList<HubGroup> OwnHubGroups => [new HubGroup(null, Api.Hubs.Value)];

    private IReadOnlyList<HubGroup> SharedHubGroups =>
        Api.SharedOwners.Value.Select(x => new HubGroup(x.Name, x.Hubs)).ToArray();

    private struct PermissionInfo
    {
        public string Permission { get; set; }
        public bool Missing { get; set; }
    }

    private IEnumerable<PermissionInfo> PermissionInfos => Constants.BasePermissions.Concat(ModuleManager.RequiredPermissions).Distinct()
        .Select(x => new PermissionInfo
        {
            Permission = PermissionTypeBindings.PermissionTypeToName[x].Name,
            Missing = !(AuthService.TokenSelf?.Permissions.Contains(x) ?? false)
        });


    private string BackendPalette => ApiHubClient.State switch
    {
        HubConnectionState.Connected => "success",
        HubConnectionState.Reconnecting or HubConnectionState.Connecting => "warning",
        _ => "error"
    };

    private string BackendStateLabel => ApiHubClient.State switch
    {
        HubConnectionState.Connected => "connected",
        HubConnectionState.Reconnecting => "reconnecting",
        HubConnectionState.Connecting => "connecting",
        _ => "offline"
    };

    private bool _disposed = false;

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await _statusSubscription.DisposeAsync();
        await _authStateSubscription.DisposeAsync();
        await _liveControlSubscription.DisposeAsync();
        await _sharedOwnersSubscription.DisposeAsync();
    }

}

