@using System.Diagnostics
@using OpenShock.Desktop.Logging
@using Serilog.Events
@using OpenShock.Desktop.Ui.ErrorHandling
@using OpenShock.Desktop.Utils
@implements IDisposable

@page "/dash/logs"

<div class="console-toolbar">
    @foreach (var level in _levels)
    {
        var enabled = _enabledLevels.Contains(level);
        <button class="@($"level-chip level-{level.ToString().ToLowerInvariant()} {(enabled ? "on" : "off")}")"
                @onclick="() => ToggleLevel(level)">
            @LevelTag(level)
        </button>
    }
    <span class="toolbar-spacer"></span>
    <button class="term-btn" @onclick="ToggleAutoScroll">@(_autoScroll ? "autoscroll: on" : "autoscroll: off")</button>
    <button class="term-btn" @onclick="ClearLogs">clear</button>
    <button class="term-btn" @onclick="OpenLogsFolder">open logs folder</button>
</div>

<div class="console" id="console-body">
    @foreach (var log in FilteredLogs)
    {
        var levelClass = log.Level.ToString().ToLowerInvariant();
        <div class="@($"log-line level-{levelClass} {(log.IsExpanded ? "expanded" : "")}")"
             @onclick="() => ToggleExpand(log)">
            <span class="log-time">@log.Time.ToString("HH:mm:ss.fff")</span>
            <span class="@($"log-level level-{levelClass}")">@LevelTag(log.Level)</span>
            <span class="log-source">@log.SourceContextShort</span>
            <span class="log-message">@log.Message</span>
        </div>
        @if (log.IsExpanded)
        {
            <pre class="log-expanded">@log.SourceContext
@log.Message</pre>
        }
    }
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private static readonly LogEventLevel[] _levels =
    {
        LogEventLevel.Verbose,
        LogEventLevel.Debug,
        LogEventLevel.Information,
        LogEventLevel.Warning,
        LogEventLevel.Error,
        LogEventLevel.Fatal,
    };

    private readonly HashSet<LogEventLevel> _enabledLevels = new(_levels);
    private bool _autoScroll = true;
    private bool _shouldScroll;

    private IEnumerable<LogStore.LogEntry> FilteredLogs =>
        LogStore.Logs.Where(l => _enabledLevels.Contains(l.Level)).OrderBy(x => x.Time);

    private static string LevelTag(LogEventLevel level) => level switch
    {
        LogEventLevel.Verbose => "TRC",
        LogEventLevel.Debug => "DBG",
        LogEventLevel.Information => "INF",
        LogEventLevel.Warning => "WRN",
        LogEventLevel.Error => "ERR",
        LogEventLevel.Fatal => "FTL",
        _ => "???"
    };

    private void ToggleLevel(LogEventLevel level)
    {
        if (!_enabledLevels.Add(level)) _enabledLevels.Remove(level);
    }

    private void ToggleAutoScroll() => _autoScroll = !_autoScroll;

    private void ToggleExpand(LogStore.LogEntry log) => log.IsExpanded = !log.IsExpanded;

    private void ClearLogs()
    {
        while (LogStore.Logs.TryDequeue(out _)) { }
    }

    protected override void OnInitialized()
    {
        LogStore.OnLogAdded = OnLogAdded;
    }

    private void OnLogAdded()
    {
        _shouldScroll = _autoScroll;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _shouldScroll)
        {
            _shouldScroll = false;
            try
            {
                await JS.InvokeVoidAsync("openshock.scrollToBottom", "console-body");
            }
            catch { /* ignore */ }
        }
    }

    private void OpenLogsFolder()
    {
        Process.Start(new ProcessStartInfo {
            FileName = Constants.LogsFolder,
            UseShellExecute = true,
            Verb = "open"
        });
    }

    public void Dispose()
    {
        LogStore.OnLogAdded = null;
    }
}

<style>
    .console-toolbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 8px;
        background: #14171a;
        border: 1px solid #2a2d31;
        border-bottom: none;
        border-radius: 4px 4px 0 0;
        font-family: 'Cascadia Code', 'Consolas', monospace;
    }

    .toolbar-spacer { flex: 1; }

    .level-chip, .term-btn {
        background: transparent;
        border: 1px solid #2e3338;
        color: #9aa0a6;
        font-family: inherit;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 3px;
        cursor: pointer;
        line-height: 1.4;
    }

    .term-btn:hover, .level-chip:hover { border-color: #4a4f55; color: #e6e6e6; }

    .level-chip.off { opacity: 0.35; text-decoration: line-through; }
    .level-chip.level-verbose.on { color: #6c7177; }
    .level-chip.level-debug.on { color: #9aa0a6; }
    .level-chip.level-information.on { color: #6cb6ff; }
    .level-chip.level-warning.on { color: #ffd166; }
    .level-chip.level-error.on { color: #ff6b6b; }
    .level-chip.level-fatal.on { color: #fff; background: #b22; border-color: #b22; }

    .console {
        height: calc(100vh - 140px);
        overflow: auto;
        background: #0b0d0e;
        border: 1px solid #2a2d31;
        border-radius: 0 0 4px 4px;
        padding: 6px 0;
        font-family: 'Cascadia Code', 'Consolas', 'Menlo', monospace;
        font-size: 12.5px;
        line-height: 1.5;
        color: #d4d4d4;
    }

    .log-line {
        padding: 0 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }

    .log-line:hover { background: rgba(255,255,255,0.04); }
    .log-line.expanded { background: rgba(255,255,255,0.06); }

    .log-time { color: #5a6066; margin-right: 10px; }
    .log-level { display: inline-block; width: 30px; font-weight: 600; margin-right: 8px; }
    .log-source { color: #b48ead; margin-right: 10px; }
    .log-message { color: #d4d4d4; }

    .log-level.level-verbose { color: #6c7177; }
    .log-level.level-debug { color: #9aa0a6; }
    .log-level.level-information { color: #6cb6ff; }
    .log-level.level-warning { color: #ffd166; }
    .log-level.level-error { color: #ff6b6b; }
    .log-level.level-fatal { color: #fff; background: #b22; padding: 0 2px; border-radius: 2px; }

    .log-line.level-warning .log-message { color: #ffe2a3; }
    .log-line.level-error .log-message { color: #ffb3b3; }
    .log-line.level-fatal .log-message { color: #ffd4d4; }

    .log-expanded {
        margin: 0;
        padding: 6px 12px 8px 12px;
        background: rgba(255,255,255,0.03);
        color: #cfd2d6;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: inherit;
        font-size: 12px;
        border-left: 2px solid #2a2d31;
    }
</style>