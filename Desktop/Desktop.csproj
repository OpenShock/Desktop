<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <SingleProject>true</SingleProject>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <ApplicationTitle>OpenShock</ApplicationTitle>

        <AssemblyName>OpenShock.Desktop</AssemblyName>
        <RootNamespace>OpenShock.Desktop</RootNamespace>
        
        <ApplicationIcon>wwwroot/images/openshock-icon.ico</ApplicationIcon>
        <SelfContained>true</SelfContained>

        <PackageIcon>wwwroot/images/Icon512.png</PackageIcon>

        <ResourceLanguages>en</ResourceLanguages>
        <SatelliteResourceLanguages>en-US;en</SatelliteResourceLanguages>
        <IsPackable>false</IsPackable>

        <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>

        <Configurations>Release-Windows;Debug-Windows;Release-Photino;Debug-Photino;Release-Web;Debug-Web</Configurations>

        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <WindowsPackageType>None</WindowsPackageType>
        <UseMaui>true</UseMaui>
        <DefineConstants>MAUI</DefineConstants>
        <StartupObject>OpenShock.Desktop.Platforms.Windows.WindowsEntryPoint</StartupObject>
        <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug-Photino' Or '$(Configuration)' == 'Release-Photino'">
        <TargetFramework>net10.0</TargetFramework>
        <StartupObject>OpenShock.Desktop.Platforms.Photino.PhotinoEntryPoint</StartupObject>
        <DefineConstants>PHOTINO</DefineConstants>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug-Photino' Or '$(Configuration)' == 'Release-Photino'">
        <PackageReference Include="Photino.Blazor" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug-Web' Or '$(Configuration)' == 'Release-Web' ">
        <TargetFramework>net10.0</TargetFramework>
        <StartupObject>OpenShock.Desktop.Platforms.Web.WebEntryPoint</StartupObject>
        <DefineConstants>WEB</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.SassCompiler" />
        <PackageReference Include="CommandLineParser" />
        <PackageReference Include="dnlib" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="Semver" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="OpenShock.SDK.CSharp" />
        <PackageReference Include="OpenShock.SDK.CSharp.Hub" />
        <PackageReference Include="OpenShock.SDK.CSharp.Live" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <!-- Tailwind CSS build: downloads the standalone tailwindcss CLI on first build and compiles wwwroot/app.css into wwwroot/css/tailwind.css. No Node required. -->
    <PropertyGroup>
        <TailwindVersion>v4.1.14</TailwindVersion>
        <TailwindInput>$(MSBuildProjectDirectory)\Styles\app.css</TailwindInput>
        <TailwindOutput>$(MSBuildProjectDirectory)\wwwroot\css\tailwind.css</TailwindOutput>
        <TailwindCliDir>$(MSBuildProjectDirectory)\obj\tailwindcli</TailwindCliDir>
    </PropertyGroup>

    <Target Name="ResolveTailwindCli">
        <PropertyGroup>
            <_TwOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_TwOs>
            <_TwOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_TwOs>
            <_TwOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">macos</_TwOs>
            <_TwArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x64</_TwArch>
            <_TwArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_TwArch>
            <_TwExt Condition="'$(_TwOs)' == 'windows'">.exe</_TwExt>
            <_TwFile>tailwindcss-$(_TwOs)-$(_TwArch)$(_TwExt)</_TwFile>
            <TailwindCli>$(TailwindCliDir)\$(TailwindVersion)-$(_TwFile)</TailwindCli>
            <TailwindUrl>https://github.com/tailwindlabs/tailwindcss/releases/download/$(TailwindVersion)/$(_TwFile)</TailwindUrl>
        </PropertyGroup>
    </Target>

    <Target Name="DownloadTailwindCli" DependsOnTargets="ResolveTailwindCli" Condition="!Exists('$(TailwindCli)')">
        <MakeDir Directories="$(TailwindCliDir)" />
        <Message Importance="high" Text="Downloading Tailwind CLI $(TailwindVersion) from $(TailwindUrl)" />
        <DownloadFile SourceUrl="$(TailwindUrl)" DestinationFolder="$(TailwindCliDir)" DestinationFileName="$(TailwindVersion)-$(_TwFile)" />
        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(TailwindCli)&quot;" />
    </Target>

    <Target Name="BuildTailwind" DependsOnTargets="DownloadTailwindCli" BeforeTargets="AssignTargetPaths;BeforeBuild" Inputs="$(TailwindInput)" Outputs="$(TailwindOutput)">
        <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\css" />
        <Message Importance="high" Text="Building Tailwind: $(TailwindInput) -&gt; $(TailwindOutput)" />
        <Exec Command="&quot;$(TailwindCli)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

    <ItemGroup>
        <None Include="Styles\**\*.css" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ModuleBase\ModuleBase.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\deps\MudBlazor\MudBlazor.min.css" />
      <_ContentIncludedByDefault Remove="wwwroot\deps\MudBlazor\MudBlazor.min.js" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

</Project>
