<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <AssemblyName>OpenShock.Desktop</AssemblyName>
        <RootNamespace>OpenShock.Desktop</RootNamespace>
        
        <ApplicationIcon>wwwroot/images/openshock-icon.ico</ApplicationIcon>
        <SelfContained>true</SelfContained>

        <PackageIcon>wwwroot/images/Icon512.png</PackageIcon>

        <ResourceLanguages>en</ResourceLanguages>
        <SatelliteResourceLanguages>en-US;en</SatelliteResourceLanguages>
        <IsPackable>false</IsPackable>

        <Configurations>Release-Photino;Debug-Photino;Release-Avalonia;Debug-Avalonia</Configurations>

    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug-Photino' Or '$(Configuration)' == 'Release-Photino'">
        <TargetFramework>net10.0</TargetFramework>
        <StartupObject>OpenShock.Desktop.Platforms.Photino.PhotinoEntryPoint</StartupObject>
        <DefineConstants>PHOTINO</DefineConstants>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug-Photino' Or '$(Configuration)' == 'Release-Photino'">
        <PackageReference Include="Photino.Blazor" />
    </ItemGroup>

    <!-- Avalonia shell. The existing Blazor UI is served by Blazor Server on loopback and shown in a NativeWebView. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug-Avalonia' Or '$(Configuration)' == 'Release-Avalonia'">
        <TargetFramework>net10.0</TargetFramework>
        <!--
          Stays Exe: Microsoft.AspNetCore.App.Internal.Assets only adds _framework/blazor.web.js to projects whose
          OutputType is exactly 'Exe'. The Windows apphost still gets the GUI subsystem (no console window) through
          the flag below, which is what WinExe would set.
        -->
        <OutputType>Exe</OutputType>
        <StartupObject>OpenShock.Desktop.Platforms.AvaloniaShell.AvaloniaEntryPoint</StartupObject>
        <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
        <!-- Without the supported OS list, NativeWebView cannot create its child window on Windows. -->
        <ApplicationManifest>Platforms/AvaloniaShell/app.manifest</ApplicationManifest>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <!-- After RuntimeIdentifier, which it depends on. -->
        <_UseWindowsGraphicalUserInterface Condition="$(RuntimeIdentifier.StartsWith('win'))">true</_UseWindowsGraphicalUserInterface>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug-Avalonia' Or '$(Configuration)' == 'Release-Avalonia'">
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Controls.WebView" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.SassCompiler" />
        <PackageReference Include="CommandLineParser" />
        <PackageReference Include="dnlib" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="Semver" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="OpenShock.Internal.Common" />
        <PackageReference Include="OpenShock.SDK.CSharp" />
        <PackageReference Include="OpenShock.SDK.CSharp.Hub" />
        <PackageReference Include="OpenShock.SDK.CSharp.Live" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ModuleBase\ModuleBase.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\deps\MudBlazor\MudBlazor.min.css" />
      <_ContentIncludedByDefault Remove="wwwroot\deps\MudBlazor\MudBlazor.min.js" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

</Project>
