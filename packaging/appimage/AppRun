#!/bin/sh
# AppRun entry point for the OpenShock Desktop AppImage.
# Resolves the AppDir, then execs the published self-contained binary.
# wwwroot and the managed assemblies live next to the binary in usr/bin,
# which is what AppDomain.BaseDirectory resolves to at runtime.

HERE="$(dirname "$(readlink -f "${0}")")"
APP_BIN="${HERE}/usr/bin/OpenShock.Desktop"

# Photino on Linux renders through WebKitGTK. It is intentionally not bundled
# (GTK/webkit do not relocate cleanly), so surface a clear error if it is missing.
if ! ldconfig -p 2>/dev/null | grep -q 'libwebkit2gtk-4\.\(0\|1\)'; then
    echo "OpenShock Desktop requires WebKitGTK (libwebkit2gtk-4.1 or 4.0) to be installed." >&2
    echo "  Debian/Ubuntu: sudo apt install libwebkit2gtk-4.1-0" >&2
    echo "  Fedora:        sudo dnf install webkit2gtk4.1" >&2
    echo "  Arch:          sudo pacman -S webkit2gtk-4.1" >&2
fi

# Desktop integration, done once when running as an AppImage.
# $APPIMAGE is set by the AppImage runtime to the absolute path of the .AppImage file.
# This installs:
#   - the icon into the user icon theme, and
#   - a .desktop entry (which also registers the openshock:// URL scheme handler).
# Both are needed so the running window has the right icon: under Wayland (KDE/GNOME)
# there is no _NET_WM_ICON, so the compositor resolves the taskbar/titlebar icon by
# matching the window app_id (the program name, "OpenShock.Desktop") to a .desktop
# entry and loading its Icon= name from the icon theme.
if [ -n "${APPIMAGE:-}" ]; then
    data_dir="${XDG_DATA_HOME:-${HOME}/.local/share}"
    apps_dir="${data_dir}/applications"
    icon_dir="${data_dir}/icons/hicolor/512x512/apps"
    handler_file="${apps_dir}/openshock-desktop.desktop"
    icon_src="${HERE}/usr/share/icons/hicolor/512x512/apps/openshock-desktop.png"

    changed=0

    # Install the icon under both the .desktop Icon= name and the window app_id
    # (the program name, "OpenShock.Desktop"). KWin resolves the *taskbar* icon via
    # the .desktop Icon=, but the *title bar* looks the icon up in the theme by the
    # window app_id directly, so the theme needs an entry under that name too.
    if [ -e "${icon_src}" ]; then
        for icon_name in openshock-desktop OpenShock.Desktop; do
            if [ ! -e "${icon_dir}/${icon_name}.png" ]; then
                mkdir -p "${icon_dir}"
                cp "${icon_src}" "${icon_dir}/${icon_name}.png"
                changed=1
            fi
        done
    fi

    if [ ! -e "${handler_file}" ]; then
        mkdir -p "${apps_dir}"
        cat > "${handler_file}" <<EOF
[Desktop Entry]
Type=Application
Name=OpenShock Desktop
Exec=${APPIMAGE} %u
Icon=openshock-desktop
Categories=Utility;Network;
Terminal=false
MimeType=x-scheme-handler/openshock;
StartupWMClass=OpenShock.Desktop
EOF
        command -v xdg-mime >/dev/null 2>&1 && \
            xdg-mime default openshock-desktop.desktop x-scheme-handler/openshock 2>/dev/null || true
        changed=1
    fi

    if [ "${changed}" -eq 1 ]; then
        command -v update-desktop-database >/dev/null 2>&1 && \
            update-desktop-database "${apps_dir}" 2>/dev/null || true
        command -v gtk-update-icon-cache >/dev/null 2>&1 && \
            gtk-update-icon-cache -f -t "${data_dir}/icons/hicolor" 2>/dev/null || true
        # Nudge KDE to rebuild its application/icon cache so the change shows immediately.
        for kb in kbuildsycoca6 kbuildsycoca5; do
            command -v "${kb}" >/dev/null 2>&1 && "${kb}" >/dev/null 2>&1 && break
        done
    fi
fi

# The desktop entry passes the openshock:// URL as a bare positional arg (%u),
# but the CLI expects it as --uri=. Translate it here.
case "${1:-}" in
    openshock:*)
        uri="$1"
        shift
        set -- --uri="${uri}" "$@"
        ;;
esac

exec "${APP_BIN}" "$@"